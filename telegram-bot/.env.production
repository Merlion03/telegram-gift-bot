# Production конфигурация для Telegram-бота
# Скопируйте этот файл в .env и заполните реальными значениями

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
# Токен бота от @BotFather
BOT_TOKEN=your_real_bot_token_here

# URL вашего веб-приложения (если используется)
WEBAPP_URL=https://your-domain.com/webapp

# =============================================================================
# POSTGRESQL DATABASE CONFIGURATION
# =============================================================================
# Хост базы данных (localhost для локального сервера)
DB_HOST=localhost

# Порт PostgreSQL (стандартный 5432)
DB_PORT=5432

# Название базы данных
DB_NAME=telegram_bot_production

# Пользователь базы данных
DB_USER=telegram_bot_user

# Пароль пользователя базы данных
DB_PASSWORD=your_secure_database_password_here

# =============================================================================
# GOOGLE SHEETS CONFIGURATION
# =============================================================================
# Путь к файлу с credentials от Google Cloud Console
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json

# ID вашей Google Sheets таблицы (из URL)
SPREADSHEET_ID=your_real_spreadsheet_id_here

# =============================================================================
# SYNC SERVICE CONFIGURATION (НОВАЯ АРХИТЕКТУРА)
# =============================================================================
# Интервал синхронизации данных из Google Sheets в PostgreSQL (в секундах)
# Рекомендуется: 60 секунд для production
SYNC_INTERVAL_SECONDS=60

# Feature flag для переключения архитектур
# true - использовать PostgreSQL (рекомендуется для production)
# false - использовать старую логику с Google Sheets API
USE_POSTGRES=true

# Размер batch для операций upsert при синхронизации
# Рекомендуется: 100 для оптимальной производительности
SYNC_BATCH_SIZE=100

# Максимальное количество попыток retry при ошибке синхронизации
SYNC_MAX_RETRIES=3

# =============================================================================
# DATABASE CONNECTION POOL CONFIGURATION
# =============================================================================
# Минимальное количество подключений в пуле
DATABASE_POOL_SIZE=5

# Максимальное количество дополнительных подключений сверх pool_size
DATABASE_MAX_OVERFLOW=15

# =============================================================================
# FSM STORAGE CONFIGURATION
# =============================================================================
# Тип хранилища состояний: 'memory' или 'redis'
# Для production рекомендуется 'redis' для персистентности
FSM_STORAGE_TYPE=memory

# URL для Redis (требуется только если FSM_STORAGE_TYPE=redis)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
# Для production рекомендуется INFO
LOG_LEVEL=INFO

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Никогда не коммитьте .env файл с реальными токенами в git
# 2. Используйте сильные пароли для базы данных
# 3. Ограничьте доступ к файлу credentials Google Sheets
# 4. Регулярно ротируйте токены и пароли
# 5. Используйте HTTPS для WEBAPP_URL