# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Google Sheets Configuration
GOOGLE_CREDENTIALS_PATH=path/to/credentials.json
SPREADSHEET_ID=your_spreadsheet_id_here

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=telegram_bot_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Application Configuration
WEBAPP_URL=https://your-webapp-url.com

# Logging Configuration
LOG_LEVEL=INFO

# FSM Storage Configuration
# Тип хранилища: 'memory' или 'redis'
FSM_STORAGE_TYPE=memory
# URL для Redis (требуется только если FSM_STORAGE_TYPE=redis)
# REDIS_URL=redis://localhost:6379/0

# Sync Service Configuration
# Интервал синхронизации данных из Google Sheets в PostgreSQL (в секундах)
SYNC_INTERVAL_SECONDS=60

# Feature flag для переключения между старой архитектурой (Google Sheets) и новой (PostgreSQL)
# true - использовать PostgreSQL для поиска призов
# false - использовать старую логику с прямыми запросами к Google Sheets
USE_POSTGRES=true

# Размер batch для операций upsert при синхронизации
SYNC_BATCH_SIZE=100

# Максимальное количество попыток retry при ошибке синхронизации
SYNC_MAX_RETRIES=3

# Database Connection Pool Configuration
# Минимальное количество подключений в пуле
DATABASE_POOL_SIZE=5

# Максимальное количество дополнительных подключений сверх pool_size
DATABASE_MAX_OVERFLOW=15

