# =============================================================================
# Конфигурация для Telegram Bot WebApp System
# =============================================================================
# ВАЖНО: Заполните все значения с "ЗАПОЛНИТЕ_ЗДЕСЬ"
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram Bot Configuration
# -----------------------------------------------------------------------------
# Получите токен у @BotFather в Telegram (команда /newbot)
BOT_TOKEN=ЗАПОЛНИТЕ_ЗДЕСЬ

# URL WebApp приложения (для локального тестирования оставьте как есть)
WEBAPP_URL=http://localhost:3000/webapp

# Уровень логирования
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# Для локального тестирования можно оставить эти значения
DB_HOST=postgres
DB_PORT=5432
DB_NAME=telegram_bot
DB_USER=postgres
DB_PASSWORD=postgres

# Переменные для Next.js DatabaseClient (используют префикс POSTGRES_*)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=telegram_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Полный DATABASE_URL для Next.js
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/telegram_bot

# -----------------------------------------------------------------------------
# Google Sheets Configuration
# -----------------------------------------------------------------------------
# Путь к credentials внутри контейнера (НЕ МЕНЯЙТЕ)
GOOGLE_CREDENTIALS_PATH=/app/credentials/google-credentials.json

# Путь к credentials на вашем компьютере (НЕ МЕНЯЙТЕ)
GOOGLE_CREDENTIALS_HOST_PATH=./credentials/google-credentials.json

# ID вашей Google Таблицы (скопируйте из URL таблицы)
# URL выглядит так: https://docs.google.com/spreadsheets/d/ВАШ_ID_ЗДЕСЬ/edit
SPREADSHEET_ID=ЗАПОЛНИТЕ_ЗДЕСЬ

# -----------------------------------------------------------------------------
# FSM Storage Configuration
# -----------------------------------------------------------------------------
# Для локального тестирования используем memory
FSM_STORAGE_TYPE=memory

# -----------------------------------------------------------------------------
# Sync Service Configuration (НОВАЯ АРХИТЕКТУРА)
# -----------------------------------------------------------------------------
# Интервал синхронизации данных из Google Sheets в PostgreSQL (в секундах)
SYNC_INTERVAL_SECONDS=60

# Feature flag для переключения между архитектурами
# true - использовать PostgreSQL для поиска призов (рекомендуется)
# false - использовать старую логику с Google Sheets API
USE_POSTGRES=true

# Размер batch для операций upsert при синхронизации
SYNC_BATCH_SIZE=100

# Максимальное количество попыток retry при ошибке синхронизации
SYNC_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Database Connection Pool Configuration
# -----------------------------------------------------------------------------
# Минимальное количество подключений в пуле
DATABASE_POOL_SIZE=5

# Максимальное количество дополнительных подключений сверх pool_size
DATABASE_MAX_OVERFLOW=15

# -----------------------------------------------------------------------------
# Realtime Configuration
# -----------------------------------------------------------------------------
# WebSocket подключения используют PostgreSQL LISTEN/NOTIFY

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
# URL Python Backend API для получения информации о призах
# Для локальной разработки используйте http://localhost:5000
# Для production укажите URL вашего Backend сервера
BACKEND_API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# NextAuth Configuration
# -----------------------------------------------------------------------------
# URL приложения (для локального тестирования оставьте как есть)
NEXTAUTH_URL=http://localhost:3000

# Секретный ключ для NextAuth (сгенерируйте командой: openssl rand -base64 32)
# Или используйте любую случайную строку минимум 32 символа
NEXTAUTH_SECRET=ЗАПОЛНИТЕ_ЗДЕСЬ

# Учётные данные для входа в админку
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ЗАПОЛНИТЕ_ЗДЕСЬ

# -----------------------------------------------------------------------------
# Next.js Configuration
# -----------------------------------------------------------------------------
WEBAPP_PORT=3000
NODE_ENV=production

# =============================================================================
# ИНСТРУКЦИЯ ПО ЗАПОЛНЕНИЮ:
# =============================================================================
#
# 1. BOT_TOKEN:
#    - Откройте Telegram, найдите @BotFather
#    - Отправьте /newbot и следуйте инструкциям
#    - Скопируйте полученный токен сюда
#
# 2. SPREADSHEET_ID:
#    - Откройте вашу Google Таблицу
#    - Скопируйте ID из URL (между /d/ и /edit)
#    - Пример: https://docs.google.com/spreadsheets/d/1a2b3c4d5e6f7g8h9i0j/edit
#    - ID: 1a2b3c4d5e6f7g8h9i0j
#
# 3. BACKEND_API_URL:
#    - Для локальной разработки: http://localhost:5000
#    - Для production: укажите URL вашего Backend API сервера
#    - Этот URL используется Next.js приложением для получения информации о призах
#
# 4. NEXTAUTH_SECRET:
#    - Сгенерируйте командой: openssl rand -base64 32
#    - Или используйте любую случайную строку минимум 32 символа
#    - Пример: my-super-secret-key-12345678901234567890
#
# 5. ADMIN_PASSWORD:
#    - Придумайте надежный пароль для входа в админку
#    - Минимум 8 символов
#
# =============================================================================
