# =============================================================================
# PRODUCTION Configuration для Telegram Bot WebApp System
# =============================================================================
# ВАЖНО: Скопируйте этот файл в .env.production и заполните все значения
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram Bot Configuration
# -----------------------------------------------------------------------------
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# URL вашего продакшен домена
WEBAPP_URL=https://yourdomain.com

# Уровень логирования для продакшена
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=telegram_bot
DB_USER=botuser
DB_PASSWORD=STRONG_PASSWORD_HERE

# Connection pooling параметры
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=15
DATABASE_POOL_PRE_PING=true

# Переменные для Next.js DatabaseClient
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=telegram_bot
POSTGRES_USER=botuser
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE

# Полный DATABASE_URL
DATABASE_URL=postgresql://botuser:STRONG_PASSWORD_HERE@postgres:5432/telegram_bot

# -----------------------------------------------------------------------------
# Google Sheets Configuration
# -----------------------------------------------------------------------------
GOOGLE_CREDENTIALS_PATH=/app/credentials/google-credentials.json
GOOGLE_CREDENTIALS_HOST_PATH=./credentials/google-credentials.json
SPREADSHEET_ID=YOUR_SPREADSHEET_ID_HERE

# -----------------------------------------------------------------------------
# FSM Storage Configuration
# -----------------------------------------------------------------------------
# Для продакшена рекомендуется использовать Redis
FSM_STORAGE_TYPE=redis
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Realtime Configuration
# -----------------------------------------------------------------------------
# WebSocket подключения используют PostgreSQL LISTEN/NOTIFY

# -----------------------------------------------------------------------------
# NextAuth Configuration
# -----------------------------------------------------------------------------
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=GENERATE_WITH_openssl_rand_base64_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=STRONG_ADMIN_PASSWORD_HERE

# -----------------------------------------------------------------------------
# Next.js Configuration
# -----------------------------------------------------------------------------
WEBAPP_PORT=3000
NODE_ENV=production

# =============================================================================
# ЧЕКЛИСТ ПЕРЕД ЗАПУСКОМ ПРОДАКШЕНА:
# =============================================================================
# 
# ✅ 1. Скопируйте этот файл: cp .env.production.example .env.production
# ✅ 2. Заполните BOT_TOKEN от @BotFather
# ✅ 3. Установите СИЛЬНЫЕ пароли для DB_PASSWORD и ADMIN_PASSWORD
# ✅ 4. Сгенерируйте NEXTAUTH_SECRET: openssl rand -base64 32
# ✅ 5. Укажите ваш домен в WEBAPP_URL и NEXTAUTH_URL
# ✅ 6. Заполните SPREADSHEET_ID вашей Google Таблицы
# ✅ 7. Положите google-credentials.json в ./credentials/
# ✅ 8. Для Redis запустите: docker-compose --profile redis up -d
# ✅ 9. Запустите: docker-compose --env-file .env.production up -d --build
#
# =============================================================================
