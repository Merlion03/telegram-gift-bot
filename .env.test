# Конфигурация для тестов (локальный запуск)
# Используется при запуске pytest локально (не в Docker)

# Database Configuration для локальных тестов (Docker PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=telegram_bot
DB_USER=postgres
DB_PASSWORD=postgres

# Telegram Bot Configuration (для тестов можно использовать фейковый токен)
BOT_TOKEN=test_token_for_unit_tests
WEBAPP_URL=http://localhost:3000/webapp

# Google Sheets Configuration (для тестов)
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json
SPREADSHEET_ID=test_spreadsheet_id

# FSM Storage
FSM_STORAGE_TYPE=memory

# Logging
LOG_LEVEL=DEBUG
